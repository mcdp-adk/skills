# Required
XAI_API_KEY=YOUR_XAI_API_KEY

# Optional proxy settings. For the same setting, a non-empty system environment variable overrides this file.
# Across proxy settings, the order is HTTPS_PROXY > ALL_PROXY > HTTP_PROXY.
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# ALL_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1
