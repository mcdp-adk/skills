# Required
XAI_API_KEY=YOUR_XAI_API_KEY

# Optional proxy settings. Non-empty system environment variables take precedence over values in this file.
# For HTTPS APIs, HTTPS_PROXY is preferred. ALL_PROXY is a fallback.
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# ALL_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1
